# Copy to .env on the server and fill in. Never commit .env.

# The domain pointing at this server. Caddy gets a certificate for it.
APP_DOMAIN=training.example.com
# Address Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.com

# Database. Generate the password with: openssl rand -base64 32
POSTGRES_USER=cali
POSTGRES_PASSWORD=
POSTGRES_DB=cali

# Coaching features. Without this, AI endpoints return 503 and the rest works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Web search tool version. The basic one returns a flat block list, which is
# what the parser expects. Later versions run search inside code execution and
# nest the blocks. Web search bills separately, at $10 per 1000 searches.
WEB_SEARCH_TOOL_VERSION=web_search_20250305

# --- Release ---------------------------------------------------------------
# Which build is live. infra/deploy.sh rewrites this line on every deploy and
# keeps the one it replaced in .deploy-prev, which is what a rollback reads.
# Leave it as latest on a fresh server; the first deploy pins it to a commit.
IMAGE_TAG=latest
# Override only if you fork the repo or push images somewhere else.
#API_IMAGE=ghcr.io/jaelricco/rung/api
#WEB_IMAGE=ghcr.io/jaelricco/rung/web

# Only needed if the GHCR packages are private AND you want to pull by hand on
# the server. CI passes its own short-lived token, so deploys don't need this.
# Use a classic PAT with read:packages, or leave empty.
GHCR_USER=
GHCR_TOKEN=
