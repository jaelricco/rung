# Copy to .env on the server and fill in. Never commit .env.

# The domain pointing at this server. Caddy gets a certificate for it.
APP_DOMAIN=training.example.com
# Address Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.com

# Database. Generate the password with: openssl rand -base64 32
POSTGRES_USER=cali
POSTGRES_PASSWORD=
POSTGRES_DB=cali

# --- Signing in ------------------------------------------------------------
# Optional: lets athletes sign in with Google or with ChatGPT instead of email
# and password. Identity only — it hands over a name, an email address and a
# picture, and buys no model access, which still comes from each athlete's own
# key below. Leave a pair empty and that button is simply not offered.
#
# Google: create an OAuth client at
# https://console.cloud.google.com/apis/credentials (type: Web application) and
# register exactly this redirect URI:
#   https://APP_DOMAIN/api/v1/auth/oauth/google/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# ChatGPT: same idea, redirect URI
#   https://APP_DOMAIN/api/v1/auth/oauth/chatgpt/callback
# "Sign in with ChatGPT" launched with named partners rather than open
# self-service registration, so getting a client ID may mean asking OpenAI.
OAUTH_CHATGPT_CLIENT_ID=
OAUTH_CHATGPT_CLIENT_SECRET=

# Endpoints are discovered from <issuer>/.well-known/openid-configuration, so
# these only need setting if a provider moves its issuer.
#OAUTH_GOOGLE_ISSUER=https://accounts.google.com
#OAUTH_CHATGPT_ISSUER=https://auth.openai.com

# Coaching features. This server holds no model key of its own: every athlete
# connects their own Anthropic or OpenAI account on the settings page and is
# billed by their own provider. Nothing here needs setting for that to work.
#
# Their keys are always stored sealed. This is the secret that seals them, and
# leaving it empty is fine — the server generates one for itself on first start
# and keeps it in the database. Setting it keeps the key out of the database
# instead, which is stronger: a database dump then carries ciphertext and
# nothing that opens it. Generate one with:
#   openssl rand -base64 32
# Changing or removing it once athletes have connected accounts makes every
# stored key unreadable, and they reconnect.
#AI_CREDENTIALS_KEY=

# Thinking. "adaptive" suits every current model on both providers; set "off"
# for a model old enough to reject the parameter.
AI_THINKING=adaptive

# Anthropic web search tool version. The basic one returns a flat block list,
# which is what the parser expects. Later versions run search inside code
# execution and nest the blocks. Web search bills separately — to the athlete
# whose key made the call, at $10 per 1000 searches.
WEB_SEARCH_TOOL_VERSION=web_search_20250305

# How many web searches one research turn may run. This is the sharpest
# control over what the coaching costs the athlete: every page the tool
# retrieves is billed to them as input, and a measured turn spent 87,000 input
# tokens on seven searches — about half the price of a whole plan. Five is the
# default. Lower it to save, raise it for better research; anything unreadable
# or below one falls back to the default, and it is capped at twelve.
#AI_RESEARCH_SEARCHES=5

# --- Release ---------------------------------------------------------------
# Which build is live. infra/deploy.sh rewrites this line on every deploy and
# keeps the one it replaced in .deploy-prev, which is what a rollback reads.
# Leave it as latest on a fresh server; the first deploy pins it to a commit.
IMAGE_TAG=latest
# Override only if you fork the repo or push images somewhere else.
#API_IMAGE=ghcr.io/jaelricco/rung/api
#WEB_IMAGE=ghcr.io/jaelricco/rung/web

# Only needed if the GHCR packages are private AND you want to pull by hand on
# the server. CI passes its own short-lived token, so deploys don't need this.
# Use a classic PAT with read:packages, or leave empty.
GHCR_USER=
GHCR_TOKEN=
