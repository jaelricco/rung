# Copy to .env on the server and fill in. Never commit .env.

# The domain pointing at this server. Caddy gets a certificate for it.
APP_DOMAIN=training.example.com
# Address Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.com

# Database. Generate the password with: openssl rand -base64 32
POSTGRES_USER=cali
POSTGRES_PASSWORD=
POSTGRES_DB=cali

# Coaching features. This server holds no model key of its own: every athlete
# connects their own Anthropic or OpenAI account on the settings page and is
# billed by their own provider. This secret is what seals those keys at rest,
# so a database backup carries nothing usable. Generate it with:
#   openssl rand -base64 32
# Without it, nobody can connect an account and the AI endpoints stay off.
# Changing it makes every already-stored key unreadable; athletes reconnect.
AI_CREDENTIALS_KEY=

# Thinking. "adaptive" suits every current model on both providers; set "off"
# for a model old enough to reject the parameter.
AI_THINKING=adaptive

# Anthropic web search tool version. The basic one returns a flat block list,
# which is what the parser expects. Later versions run search inside code
# execution and nest the blocks. Web search bills separately — to the athlete
# whose key made the call, at $10 per 1000 searches.
WEB_SEARCH_TOOL_VERSION=web_search_20250305

# --- Release ---------------------------------------------------------------
# Which build is live. infra/deploy.sh rewrites this line on every deploy and
# keeps the one it replaced in .deploy-prev, which is what a rollback reads.
# Leave it as latest on a fresh server; the first deploy pins it to a commit.
IMAGE_TAG=latest
# Override only if you fork the repo or push images somewhere else.
#API_IMAGE=ghcr.io/jaelricco/rung/api
#WEB_IMAGE=ghcr.io/jaelricco/rung/web

# Only needed if the GHCR packages are private AND you want to pull by hand on
# the server. CI passes its own short-lived token, so deploys don't need this.
# Use a classic PAT with read:packages, or leave empty.
GHCR_USER=
GHCR_TOKEN=
