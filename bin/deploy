#!/usr/bin/env bash
# Commit, push, and follow the release all the way to the server.
#
#   bin/deploy -m "message"     commit everything, push, watch CI and the deploy
#   bin/deploy --no-commit      push what is already committed
#   bin/deploy --dry-run        show what would be committed and stop
#
# Needs only a GitHub token — no docker, no ssh, no route to the server.
# Everything after the push happens on GitHub's runner.

source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

MESSAGE=""
DO_COMMIT=true
DRY_RUN=false
BRANCH="${BRANCH:-main}"

while [[ $# -gt 0 ]]; do
	case "$1" in
	-m | --message) MESSAGE="$2"; shift 2 ;;
	--no-commit) DO_COMMIT=false; shift ;;
	--dry-run) DRY_RUN=true; shift ;;
	-b | --branch) BRANCH="$2"; shift 2 ;;
	-h | --help) sed -n '2,12p' "$0"; exit 0 ;;
	*) die "unknown option: $1" ;;
	esac
done

require_token
detect_repo
cd "$REPO_ROOT" || die "cannot enter $REPO_ROOT"

current_branch="$(git rev-parse --abbrev-ref HEAD)"
[[ "$current_branch" == "$BRANCH" ]] ||
	warn "on '$current_branch', not '$BRANCH' — only $BRANCH deploys, this will just run CI"

if [[ -n "$(git status --porcelain)" ]]; then
	say "uncommitted changes"
	git -c color.status=always status --short
	if [[ "$DRY_RUN" == true ]]; then exit 0; fi
	[[ "$DO_COMMIT" == true ]] || die "working tree is dirty and --no-commit was given."
	[[ -n "$MESSAGE" ]] || die "there are changes to commit; pass -m \"what changed\"."
	git add -A
	git commit -q -m "$MESSAGE"
	ok "committed"
elif [[ "$DRY_RUN" == true ]]; then
	info "nothing to commit"
	exit 0
fi

COMMENT_BEFORE="$(latest_ops_comment_id)"

say "pushing to $REPO ($current_branch)"
# The token goes on the command line for this one call rather than into
# .git/config, so it is never written to disk.
git push -q "https://x-access-token:${GITHUB_TOKEN}@github.com/${REPO}.git" \
	"HEAD:refs/heads/$current_branch"
SHA="$(git rev-parse HEAD)"
ok "pushed ${SHA:0:12}"

say "waiting for the run to start"
RUN_ID=""
for _ in $(seq 1 30); do
	RUN_ID="$(gh_api GET "/repos/$REPO/actions/runs?head_sha=$SHA&per_page=10" |
		python3 -c '
import json,sys
runs=[r for r in json.load(sys.stdin).get("workflow_runs",[]) if r["name"]=="CI"]
print(runs[0]["id"] if runs else "")')"
	[[ -n "$RUN_ID" ]] && break
	sleep 4
done
[[ -n "$RUN_ID" ]] || die "no CI run appeared for ${SHA:0:12}. Check $(run_url '')"
info "$(run_url "$RUN_ID")"

watch_run "$RUN_ID"

echo
if [[ "$RUN_CONCLUSION" == "success" ]]; then
	ok "deployed ${SHA:0:12}"
else
	warn "run finished: $RUN_CONCLUSION"
fi

# The deploy job posts its server-side transcript to the ops-log issue, which
# is readable over the plain API even where Actions log downloads are not.
for _ in $(seq 1 10); do
	body="$(latest_ops_comment "$COMMENT_BEFORE" || true)"
	[[ -n "$body" ]] && break
	sleep 3
done
if [[ -n "${body:-}" ]]; then
	echo
	say "server transcript"
	printf '%s\n' "$body" | sed 's/^/    /'
fi

[[ "$RUN_CONCLUSION" == "success" ]] || exit 1
